    "file": "config/scenarios.json",
    "field": "assumptions.0",
    "value": "Six fixed OD demands are independent of the number of route candidates; each OD requests one vehicle every 30 seconds before 1200 seconds."
  },
  {
    "file": "config/scenarios.json",
    "field": "assumptions.1",
    "value": "The 600-1200 second speed restriction is an assumed engineering event, not an observed accident, measured capacity reduction or reconstructed real traffic window."
  },
  {
    "file": "config/scenarios.json",
    "field": "assumptions.2",
    "value": "Only west-to-hospital departures at or after event publication and during its active interval may reconsider their route. Compare the complete same-endpoint candidates, including the default, using sum(external segment length/current known speed); ties retain the default."
  },
  {
    "file": "config/scenarios.json",
    "field": "assumptions.3",
    "value": "Route-cost estimates use the current known restriction without anticipating its future end; they omit uncalibrated junction/queue delays and are not actual trip-time observations."
  },
  {
    "file": "config/scenarios.json",
    "field": "assumptions.4",
    "value": "Both the primary 1 m/s event and the predeclared 0.5 m/s severity sensitivity are reported in full, including unchanged policies or worse outcomes."
  },
  {
    "file": "config/scenarios.json",
    "field": "assumptions.5",
    "value": "All routes are assigned before scheduled departure; vehicles already assigned are not rerouted in the network. Future hospital tasks do not affect earlier decisions."
  },
  {
    "file": "config/scenarios.json",
    "field": "assumptions.6",
    "value": "Hospital tasks share the same assumed_car type as background traffic; there is no special speed, signal priority, lane privilege or traffic-rule exemption."
  },
  {
    "file": "config/scenarios.json",
    "field": "assumptions.7",
    "value": "S3 here tests the task interface and independent route guidance only; coordinated governance B is not implemented."
  },
  {
    "file": "config/scenarios.json",
    "field": "assumptions.8",
    "value": "All findings are engineering diagnostics under assumptions, not validated real-world governance effects. A longer detour may worsen results."
  },
