  "requirements": [
    {
      "id": "F01",
      "requirement": "论文单独PDF，不压缩，不含承诺书，≤20 MB；官方文件未规定页数上限"
    },
    {
      "id": "F02",
      "requirement": "第一页为摘要页，含题目/摘要/关键词，摘要一般≤一页；下一页起目录及正文"
    },
    {
      "id": "F03",
      "requirement": "从摘要页起页脚居中阿拉伯数字1连续编号，无页眉及参赛者/学校身份标志"
    },
    {
      "id": "F04",
      "requirement": "题目三号黑体；一级标题四号黑体且居中；其他中文小四宋体；单倍行距"
    },
    {
      "id": "F05",
      "requirement": "正文方括号数字引用；参考文献按正文首次引用顺序排列；网页列作者/标题/网址/访问年月日"
    },
    {
      "id": "F06",
      "requirement": "附录列出真实支撑材料文件，所有代码与自主查阅数据需支撑；支撑ZIP或RAR≤20 MB，不含承诺书"
    },
    {
      "id": "F07",
      "requirement": "视频MP4≤3分钟，≥1280×720，≤300 MB；命名题号-队伍号-fz，实际运行+剪辑"
    },
    {
      "id": "C01",
      "requirement": "Q1（20分）覆盖实践背景/数字孪生结构、数据条件、平行空间和基准模型、泛化性与结果；数据/平行空间/模型/封装各5分"
    },
    {
      "id": "C02",
      "requirement": "Q2（25分）覆盖拥堵结构背景、数据条件、A模型、结果、与前项对比；模型10/结果5/时空5/解释理论5"
    },
    {
      "id": "C03",
      "requirement": "Q3（25分）覆盖应急协同结构背景、数据条件、B模型、结果、与前项对比；模型10/结果5/时空5/解释理论5"
    },
    {
      "id": "C04",
      "requirement": "论文说明数据—平行空间—仿真系统的封装技术路线，并给结果与时间步长的对应图示及解释理论"
    },
    {
      "id": "A01",
      "requirement": "参考文献后必须明确AI使用声明，正文AI生成内容/结果/图表/参数优化处注明贡献，并引用工具"
    },
    {
      "id": "A02",
      "requirement": "支撑材料必须有AI工具详情PDF，含版本、用途环节、关键交互、采纳与人工修改实际状态"
    },
    {
      "id": "A03",
      "requirement": "不能把AI核查写成队员独立完成；赛方要求核心建模、仿真实现与分析由队员独立完成"
    },
    {
      "id": "A04",
      "requirement": "AI辅助程序注释需工具/版本/机构/版本发布日期；模型未暴露发布日期时不得编造"
    }
  ],
  "official_version_note": "AI PDF正文标2025年试行；2026论文规范提2026相关要求。以已提供文件实际正文引用，未声称已核实不存在的2026 AI新版本。",
